{
  "manifest_version": 3,
  "name": "Hide Adds",
  "version": "0.3.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111",
  "description": "Hide distracting ads, banners, and overlays for a cleaner browsing experience.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "action": {
    "default_title": "Hide Adds",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rts.rs/*",
        "https://rts.rs/*"
      ],
      "js": [
        "src/vendor/rts-cookies.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "src/google-ads.css",
        "src/billboards.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "src/vignette.js"
      ]
    },
    {
      "matches": [
        "https://mail.yahoo.com/*"
      ],
      "css": [
        "src/yahoo-mail.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.piratebay.party/*"
      ],
      "js": [
        "src/disable-links.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.piratebay.party/*"
      ],
      "js": [
        "src/piratebay-guard.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "piratebay_blocker",
        "enabled": true,
        "path": "rules/piratebay.json"
      }
    ]
  }
}
