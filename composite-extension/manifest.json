{
  "manifest_version": 3,
  "name": "Composite Extension",
  "version": "0.2.2",
  "minimum_chrome_version": "111",
  "description": "Block Google ads across websites, hide Yahoo Mail clutter, and block unwanted Pirate Bay navigation.",
  "permissions": ["declarativeNetRequest"],
  "action": {
    "default_title": "Composite Extension",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["src/google-ads.css", "src/billboards.css"],
      "js": ["src/google-ads.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.yahoo.com/*"],
      "css": ["src/yahoo-mail.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.piratebay.party/*"],
      "js": ["src/disable-links.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.piratebay.party/*"],
      "js": ["src/piratebay-guard.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {"id": "piratebay_blocker", "enabled": true, "path": "rules/piratebay.json"},
      {"id": "google_ads", "enabled": true, "path": "rules/google-ads.json"}
    ]
  }
}
